    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "caniuse-lite": "^1.0.30001810",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "effect": "^3.22.2",
    "es-toolkit": "^1.52.0",
    "fast-check": "^4.10.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.13",
    "lodash": "^4.18.1",
