  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "postinstall": "prisma generate || echo \"prisma generate skipped\"",
    "prestart": "npx prisma generate || echo \"prisma generate skipped\"",
    "start": "nest start",
    "prestart:dev": "npx prisma generate || echo \"prisma generate skipped\"",
    "start:dev": "nest start --watch",
    "prestart:debug": "npx prisma generate || echo \"prisma generate skipped\"",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npx prisma generate || echo \"prisma generate skipped\"",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
